<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Warm cream base — ~62% opacity (A0) so wallpaper shows through like dark mode -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#A0F5EDD8"
                android:endColor="#A0EEE0C4" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Golden shimmer border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0EC19A6B" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#65C19A6B" />
        </shape>
    </item>
</layer-list>
