<?xml version="1.0" encoding="utf-8"?>
<!-- GradientDrawable بسيطة — شفافة تماماً عشان الـ corners الخارجية تظهر الخلفية (الـ wallpaper)
     clipToOutline يستخدم الـ corners هنا كـ outline للـ clip فقط، الـ visual background جاي من الـ sky bitmap -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- alpha يجب أن يكون > 0 عشان GradientDrawable.getOutline() يرجع outline صالح
         وبالتالي clipToOutline يشتغل فعلاً — #00000000 يرجع outline فاضي تماماً
         #01000000 = alpha 1/255 (شبه شفاف بصرياً 100%) بس يكفي للـ outline -->
    <solid android:color="#01000000" />
    <corners android:radius="24dp" />
</shape>
