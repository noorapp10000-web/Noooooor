<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:layoutDirection="rtl">

    <!-- ── Header: نُور + Hijri date (right) · city (left) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Right: app name + hijri date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="نُور"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wg_hijri_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#AAC19A6B"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Left: city -->
        <TextView
            android:id="@+id/wg_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#AAFFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- ── Main glass card ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_card_bg"
        android:padding="10dp"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الصلاة القادمة"
            android:gravity="center"
            android:textColor="#80C19A6B"
            android:textSize="10sp" />

        <!-- Prayer icon + name -->
        <TextView
            android:id="@+id/wg_prayer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="..."
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="6dp" />

        <!-- Countdown: hh : mm : ss -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="ltr">

            <TextView
                android:id="@+id/wg_hours"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="@drawable/widget_number_bg"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="00" />

            <TextView
                android:layout_width="14dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=":"
                android:textColor="#C0C19A6B"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/wg_minutes"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="@drawable/widget_number_bg"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="00" />

            <TextView
                android:layout_width="14dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=":"
                android:textColor="#C0C19A6B"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/wg_seconds"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="@drawable/widget_number_bg"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="00" />
        </LinearLayout>

        <!-- ── Progress bar section ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <!-- Prev · ━━━●━━━ · Next labels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp"
                android:layoutDirection="ltr">

                <TextView
                    android:id="@+id/wg_prev_prayer"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#80C19A6B"
                    android:textSize="9sp"
                    android:gravity="start" />

                <TextView
                    android:id="@+id/wg_next_prayer"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#80C19A6B"
                    android:textSize="9sp"
                    android:gravity="end" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/wg_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:progressDrawable="@drawable/widget_progress"
                android:max="100"
                android:progress="50" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
