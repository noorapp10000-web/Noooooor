<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#00000000"
    android:padding="10dp"
    android:layoutDirection="rtl">

    <!-- ══ HEADER ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <!-- Right: title + username -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/wg_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="نُور"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Theme toggle: TextView so we can set ☀/◑ text via setTextViewText() -->
                <TextView
                    android:id="@+id/wg_theme_toggle"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="◑"
                    android:textSize="14sp"
                    android:background="#30FFFFFF"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

            <TextView
                android:id="@+id/wg_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#99C19A6B"
                android:textSize="9sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Left: city + current prayer + hijri (medium) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/wg_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                android:gravity="end" />

            <TextView
                android:id="@+id/wg_current_prayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#AAC19A6B"
                android:textSize="8sp"
                android:gravity="end"
                android:layout_marginTop="1dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/wg_hijri_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#88C19A6B"
                android:textSize="8sp"
                android:gravity="end"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══ MAIN CARD ══ -->
    <LinearLayout
        android:id="@+id/wg_main_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/wg_next_prayer_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الصلاة القادمة"
            android:gravity="center"
            android:textColor="#90C19A6B"
            android:textSize="9sp"
            android:visibility="gone" />

        <!-- Prayer name -->
        <TextView
            android:id="@+id/wg_prayer_name_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text=""
            android:visibility="gone" />

        <TextView
            android:id="@+id/wg_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="..."
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/wg_remaining_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="متبقي على الأذان"
            android:gravity="center"
            android:textColor="#80C19A6B"
            android:textSize="8.5sp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <!-- Countdown hh:mm:ss -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="ltr">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/wg_hours"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:background="#20FFFFFF"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:text="00" />
                <TextView
                    android:id="@+id/wg_hours_label"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="ساعة"
                    android:textColor="#C19A6B"
                    android:textSize="8sp"
                    android:gravity="center"
                    android:layout_marginTop="2dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="14dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=":"
                android:textColor="#C0C19A6B"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/wg_minutes"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:background="#20FFFFFF"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:text="00" />
                <TextView
                    android:id="@+id/wg_minutes_label"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="دقيقة"
                    android:textColor="#C19A6B"
                    android:textSize="8sp"
                    android:gravity="center"
                    android:layout_marginTop="2dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="14dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=":"
                android:textColor="#C0C19A6B"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/wg_seconds"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:background="#20FFFFFF"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:text="00" />
                <TextView
                    android:id="@+id/wg_seconds_label"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="ثانية"
                    android:textColor="#C19A6B"
                    android:textSize="8sp"
                    android:gravity="center"
                    android:layout_marginTop="2dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/wg_adhan_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:gravity="center"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp"
            android:layout_marginTop="4dp" />

        <!-- Progress bar percentage text -->
        <TextView
            android:id="@+id/wg_progress_pct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:gravity="center"
            android:textColor="#90C19A6B"
            android:textSize="8sp"
            android:layout_marginTop="5dp"
            android:visibility="gone" />

        <!-- ProgressBar widget — replaces plain View elements (View not allowed in RemoteViews on EMUI) -->
        <ProgressBar
            android:id="@+id/wg_progress_container"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="3dp"
            android:progressDrawable="@drawable/widget_progress"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:layoutDirection="ltr"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wg_remaining_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:gravity="center"
            android:textColor="#70C19A6B"
            android:textSize="8sp"
            android:layout_marginTop="3dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ══ 5 PRAYERS ROW ══ -->
    <LinearLayout
        android:id="@+id/wg_prayers_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/wg_fajr_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#20FFFFFF"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp">
            <TextView android:id="@+id/wg_fajr_icon" android:layout_width="0dp" android:layout_height="0dp" android:text="" android:visibility="gone" />
            <TextView android:id="@+id/wg_fajr_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الفجر" android:textColor="#BBFFFFFF" android:textSize="8sp" android:gravity="center" />
            <TextView android:id="@+id/wg_fajr_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#C19A6B" android:textSize="8.5sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_dhuhr_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#20FFFFFF"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp">
            <TextView android:id="@+id/wg_dhuhr_icon" android:layout_width="0dp" android:layout_height="0dp" android:text="" android:visibility="gone" />
            <TextView android:id="@+id/wg_dhuhr_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الظهر" android:textColor="#BBFFFFFF" android:textSize="8sp" android:gravity="center" />
            <TextView android:id="@+id/wg_dhuhr_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#C19A6B" android:textSize="8.5sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_asr_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#20FFFFFF"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp">
            <TextView android:id="@+id/wg_asr_icon" android:layout_width="0dp" android:layout_height="0dp" android:text="" android:visibility="gone" />
            <TextView android:id="@+id/wg_asr_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العصر" android:textColor="#BBFFFFFF" android:textSize="8sp" android:gravity="center" />
            <TextView android:id="@+id/wg_asr_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#C19A6B" android:textSize="8.5sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_maghrib_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#20FFFFFF"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp">
            <TextView android:id="@+id/wg_maghrib_icon" android:layout_width="0dp" android:layout_height="0dp" android:text="" android:visibility="gone" />
            <TextView android:id="@+id/wg_maghrib_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المغرب" android:textColor="#BBFFFFFF" android:textSize="8sp" android:gravity="center" />
            <TextView android:id="@+id/wg_maghrib_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#C19A6B" android:textSize="8.5sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_isha_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#20FFFFFF"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp">
            <TextView android:id="@+id/wg_isha_icon" android:layout_width="0dp" android:layout_height="0dp" android:text="" android:visibility="gone" />
            <TextView android:id="@+id/wg_isha_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العشاء" android:textColor="#BBFFFFFF" android:textSize="8sp" android:gravity="center" />
            <TextView android:id="@+id/wg_isha_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#C19A6B" android:textSize="8.5sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══ BOTTOM BAR (large only) ══ -->
    <LinearLayout
        android:id="@+id/wg_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/wg_hijri_date_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#C19A6B"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/wg_hijri_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="التاريخ الهجري"
                android:textColor="#66FFFFFF"
                android:textSize="7.5sp" />
        </LinearLayout>

        <!-- Separator: TextView used instead of plain View (View not allowed in EMUI RemoteViews) -->
        <TextView
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="#30FFFFFF"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:id="@+id/wg_day_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="end" />
            <TextView
                android:id="@+id/wg_day_pct_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="نسبة اليوم المنقضي"
                android:textColor="#66FFFFFF"
                android:textSize="7.5sp"
                android:gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden placeholder IDs used by Java -->
    <TextView android:id="@+id/wg_prev_prayer" android:layout_width="0dp" android:layout_height="0dp" android:text="" android:visibility="gone" />
    <TextView android:id="@+id/wg_next_prayer" android:layout_width="0dp" android:layout_height="0dp" android:text="" android:visibility="gone" />

</LinearLayout>
