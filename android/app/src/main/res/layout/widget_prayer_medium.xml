<?xml version="1.0" encoding="utf-8"?>
<!-- Medium widget: 4×2 — prayer + countdown side by side + progress bar -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:layoutDirection="rtl">

    <!-- ── Header row: نُور · city ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="نُور"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wg_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#99FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- ── Content row: prayer name (right) · countdown (left) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_card_bg"
        android:padding="10dp">

        <!-- Right: prayer icon + name -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصلاة القادمة"
                android:textColor="#80C19A6B"
                android:textSize="9sp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/wg_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Left: countdown hh:mm:ss -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="ltr">

            <TextView
                android:id="@+id/wg_hours"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:background="@drawable/widget_number_bg"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:text="00" />

            <TextView
                android:layout_width="12dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=":"
                android:textColor="#C0C19A6B"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingBottom="3dp" />

            <TextView
                android:id="@+id/wg_minutes"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:background="@drawable/widget_number_bg"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:text="00" />

            <TextView
                android:layout_width="12dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=":"
                android:textColor="#C0C19A6B"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingBottom="3dp" />

            <TextView
                android:id="@+id/wg_seconds"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:background="@drawable/widget_number_bg"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:text="00" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Progress bar ── -->
    <ProgressBar
        android:id="@+id/wg_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="8dp"
        android:progressDrawable="@drawable/widget_progress"
        android:max="100"
        android:progress="50" />

</LinearLayout>
