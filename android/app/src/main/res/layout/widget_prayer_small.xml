<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp"
    android:gravity="center_horizontal"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="rtl">
            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/ic_location_pin"
                android:layout_marginEnd="2dp"
                android:alpha="0.75" />
            <TextView
                android:id="@+id/wg_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#AAFFFFFF"
                android:textSize="7.5sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/wg_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="نُور"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/wg_theme_toggle"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="5dp"
                android:src="@drawable/ic_widget_theme_dark"
                android:background="@drawable/widget_theme_btn_bg_dark"
                android:padding="3dp"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

    <!-- Prayer icon + name -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="5dp">
        <ImageView
            android:id="@+id/wg_prayer_name_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_prayer_dhuhr"
            android:scaleType="fitCenter"
            android:layout_marginEnd="4dp" />
        <TextView
            android:id="@+id/wg_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="..."
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- Countdown: hh : mm : ss -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:layout_marginBottom="4dp">
        <TextView
            android:id="@+id/wg_hours"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:background="@drawable/widget_number_bg"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="00" />
        <TextView android:layout_width="10dp" android:layout_height="wrap_content" android:gravity="center" android:text=":" android:textColor="#C0C19A6B" android:textSize="15sp" android:textStyle="bold" android:paddingBottom="2dp" />
        <TextView
            android:id="@+id/wg_minutes"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:background="@drawable/widget_number_bg"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="00" />
        <TextView android:layout_width="10dp" android:layout_height="wrap_content" android:gravity="center" android:text=":" android:textColor="#C0C19A6B" android:textSize="15sp" android:textStyle="bold" android:paddingBottom="2dp" />
        <TextView
            android:id="@+id/wg_seconds"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:background="@drawable/widget_number_bg"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="00" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/wg_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progressDrawable="@drawable/widget_progress"
        android:indeterminate="false"
        android:max="100"
        android:progress="50"
        android:layoutDirection="ltr" />

    <TextView
        android:id="@+id/wg_adhan_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#99C19A6B"
        android:textSize="7.5sp"
        android:layout_marginTop="3dp"
        android:gravity="center" />

    <!-- Hidden placeholders -->
    <TextView android:id="@+id/wg_hijri_date"     android:layout_width="0dp" android:layout_height="0dp" android:text="" android:visibility="gone" />
    <TextView android:id="@+id/wg_username"        android:layout_width="0dp" android:layout_height="0dp" android:text="" android:visibility="gone" />
    <TextView android:id="@+id/wg_day_pct"         android:layout_width="0dp" android:layout_height="0dp" android:text="" android:visibility="gone" />
    <TextView android:id="@+id/wg_current_prayer"  android:layout_width="0dp" android:layout_height="0dp" android:text="" android:visibility="gone" />
    <TextView android:id="@+id/wg_remaining_text"  android:layout_width="0dp" android:layout_height="0dp" android:text="" android:visibility="gone" />
</LinearLayout>
