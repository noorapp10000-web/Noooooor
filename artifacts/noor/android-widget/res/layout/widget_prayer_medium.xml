<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp"
    android:layoutDirection="rtl">

    <!-- ── Header: city · نُور · hijri date ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/wg_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📍 القاهرة"
            android:textColor="#CCF5C878"
            android:textSize="8sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="نُور"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="6dp" />

        <TextView
            android:id="@+id/wg_hijri_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#88C19A6B"
            android:textSize="8sp"
            android:gravity="start" />

    </LinearLayout>

    <!-- ── Prayer + countdown row ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_card_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Right: label + prayer name -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصلاة القادمة"
                android:textColor="#90C19A6B"
                android:textSize="8sp"
                android:layout_marginBottom="2dp" />
            <TextView
                android:id="@+id/wg_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="..."
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />
            <TextView
                android:id="@+id/wg_adhan_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="وقت الأذان --:--"
                android:textColor="#99F5C878"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Left: countdown hh:mm:ss with labels -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="ltr">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/wg_hours"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:background="@drawable/widget_number_bg"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:text="00" />
                <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:text="ساعات" android:textColor="#70C19A6B" android:textSize="7sp" android:gravity="center" android:layout_marginTop="1dp" />
            </LinearLayout>

            <TextView android:layout_width="10dp" android:layout_height="wrap_content" android:gravity="center" android:text=":" android:textColor="#C0C19A6B" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="10dp" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/wg_minutes"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:background="@drawable/widget_number_bg"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:text="00" />
                <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:text="دقيقة" android:textColor="#70C19A6B" android:textSize="7sp" android:gravity="center" android:layout_marginTop="1dp" />
            </LinearLayout>

            <TextView android:layout_width="10dp" android:layout_height="wrap_content" android:gravity="center" android:text=":" android:textColor="#C0C19A6B" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="10dp" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/wg_seconds"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:background="@drawable/widget_number_bg"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:text="00" />
                <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:text="ثانية" android:textColor="#70C19A6B" android:textSize="7sp" android:gravity="center" android:layout_marginTop="1dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- ── Progress bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="3dp"
        android:layoutDirection="ltr">
        <TextView
            android:id="@+id/wg_prev_prayer"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#70C19A6B"
            android:textSize="7sp"
            android:gravity="start" />
        <TextView
            android:id="@+id/wg_progress_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#88C19A6B"
            android:textSize="7sp" />
        <TextView
            android:id="@+id/wg_next_prayer"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#70C19A6B"
            android:textSize="7sp"
            android:gravity="end" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/wg_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginBottom="5dp"
        android:progressDrawable="@drawable/widget_progress"
        android:max="100"
        android:progress="50"
        android:layoutDirection="ltr" />

    <!-- ── 5 Prayers compact row ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/wg_isha_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/widget_prayer_cell_bg">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌙" android:textSize="11sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العشاء" android:textColor="#AAFFFFFF" android:textSize="7sp" />
            <TextView android:id="@+id/wg_isha_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#EEFFFFFF" android:textSize="8sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_maghrib_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/widget_prayer_cell_bg">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌇" android:textSize="11sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المغرب" android:textColor="#AAFFFFFF" android:textSize="7sp" />
            <TextView android:id="@+id/wg_maghrib_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#EEFFFFFF" android:textSize="8sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_asr_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/widget_prayer_cell_bg">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌤️" android:textSize="11sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العصر" android:textColor="#AAFFFFFF" android:textSize="7sp" />
            <TextView android:id="@+id/wg_asr_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#EEFFFFFF" android:textSize="8sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_dhuhr_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/widget_prayer_cell_bg">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="11sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الظهر" android:textColor="#AAFFFFFF" android:textSize="7sp" />
            <TextView android:id="@+id/wg_dhuhr_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#EEFFFFFF" android:textSize="8sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_fajr_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/widget_prayer_cell_bg">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌅" android:textSize="11sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الفجر" android:textColor="#AAFFFFFF" android:textSize="7sp" />
            <TextView android:id="@+id/wg_fajr_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#EEFFFFFF" android:textSize="8sp" android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
