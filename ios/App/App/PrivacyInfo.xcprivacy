<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PrivacyInfo.xcprivacy — مطلوب من Apple لكل التطبيقات منذ iOS 17.4
  يصف هذا الملف:
  1. أنواع البيانات التي يجمعها التطبيق
  2. سبب الوصول إلى APIs الخاصة بالخصوصية
  يجب إضافته لـ Xcode project: File → Add Files to App
-->
<plist version="1.0">
<dict>
  <!-- كل بيانات المستخدم والموقع تُعالَج محلياً ولا تُنقل إلى خادم -->
  <key>NSPrivacyCollectedDataTypes</key>
  <array/>

  <!-- ── هل يتتبع التطبيق المستخدم عبر تطبيقات أخرى؟ لا ── -->
  <key>NSPrivacyTracking</key>
  <false/>

  <!-- إضافات Capacitor تصف Required Reason APIs في manifests الخاصة بها -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array/>
</dict>
</plist>
